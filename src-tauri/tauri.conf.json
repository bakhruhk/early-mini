{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Early Mini",
  "version": "1.0.1",
  "identifier": "com.earlymini.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Early Mini",
        "width": 280,
        "height": 52,
        "minWidth": 220,
        "minHeight": 48,
        "maxWidth": 960,
        "maxHeight": 520,
        "decorations": false,
        "alwaysOnTop": true,
        "transparent": true,
        "resizable": true,
        "skipTaskbar": false,
        "windowEffects": {
          "effects": ["hudWindow", "mica"],
          "state": "active",
          "radius": 24
        }
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    }
  }
}
